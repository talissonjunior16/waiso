# Copy to .env and fill in. The three required values have no default, and the
# stack refuses to start without them: a shipped default secret would be the same
# secret on every installation in the world.

# ── Required ─────────────────────────────────────────────────────────────────

# Password for the bundled PostgreSQL.
POSTGRES_PASSWORD=

# Encrypts every secret stored in the database — integration credentials, S3
# keys and API keys.
#
#   openssl rand -base64 32
#
# BACK THIS UP somewhere other than the machine it runs on. A database restored
# without it holds secrets nobody can decrypt.
DB_CREDENTIALS_KEY=

# Authenticates the scraper engine to the API. Any long random string:
#
#   openssl rand -hex 32
#
SCRAPER_ENGINE_SECRET=

# ── Public addresses ─────────────────────────────────────────────────────────
# Where your users' browsers reach each service. The defaults work on the machine
# running the stack; set these when people connect from elsewhere, behind a
# reverse proxy that terminates HTTPS. Each hostname needs its own DNS record
# pointing at this server — see "Domains and HTTPS" in the README.

#WAISO_PUBLIC_UI_URL=https://waiso.example.com
#WAISO_PUBLIC_API_URL=https://api.waiso.example.com
#WAISO_PUBLIC_LSP_URL=wss://lsp.waiso.example.com

# ── Optional ─────────────────────────────────────────────────────────────────

# Pin a release. Unset, the stack runs the version this file shipped with.
#WAISO_VERSION=1.0.0

# A managed PostgreSQL instead of the bundled one. Set this and delete the
# `postgres` service from docker-compose.yml.
#DATABASE_URL=postgres://user:password@db.example.com:5432/waiso

# Host ports. Behind a reverse proxy, bind them to loopback
# (e.g. 127.0.0.1:8080): Docker publishes ports past the host firewall.
#WAISO_UI_PORT=8080
#WAISO_API_PORT=3000
#WAISO_LSP_PORT=3001

# Jobs one worker runs at once, and its memory ceiling.
#WORKER_CONCURRENCY=12
#WORKER_MEM_LIMIT_MB=2048
#WORKER_MEM_LIMIT=2g

# Concurrent queries against YOUR databases — size it for that server.
#SQL_WORKER_CONCURRENCY=6

# How scripts are isolated. `sandbox` isolates every run and needs the
# SYS_ADMIN + NET_ADMIN capabilities, which some hosts forbid. `none` runs
# scripts as ordinary processes, isolated by the container alone — only
# appropriate when you trust everyone who can write a script on this instance.
#ISOLATION_LEVEL=sandbox

# The AppArmor profile the worker runs under. On hosts that enforce AppArmor
# (Ubuntu, Debian, SUSE), install it once before `docker compose up`:
#
#   sudo install -m 0644 apparmor/waiso-worker /etc/apparmor.d/waiso-worker
#   sudo apparmor_parser -r -W /etc/apparmor.d/waiso-worker
#
# Docker's default profile forbids the mounts the sandbox makes, so with it every
# Python, C and C++ run fails. Hosts without AppArmor ignore this setting.
#WORKER_APPARMOR_PROFILE=waiso-worker
