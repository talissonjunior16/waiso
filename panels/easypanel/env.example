# Paste into the Compose service's Environment and turn on "Create .env file".
# Make each secret once:  openssl rand -hex 32  (passwords)  ·  openssl rand -base64 32  (DB_CREDENTIALS_KEY)
# The Waiso release every service runs: change this one line to update (api, workers, web app, robot engine, editor).
WAISO_VERSION=1.8.7
POSTGRES_PASSWORD=
DB_CREDENTIALS_KEY=
SCRAPER_ENGINE_SECRET=
# The three domains you add under Domains (https:// and wss:// once their certificates are issued).
UI_URL=https://waiso.example.com
API_URL=https://api.waiso.example.com
LSP_URL=wss://lsp.waiso.example.com
WAISO_UPDATE_CHECK=on
WAISO_APPS_DOMAIN=
